# ProGit Environment Variables Example
PROGIT_APP_NAME=ProGit
PROGIT_DOMAIN=localhost
PROGIT_HTTP_PORT=3000
PROGIT_ROOT_URL=http://localhost:3000/
PROGIT_DB_PATH=/data/db/progit.db
PROGIT_REPO_ROOT=/data/repositories
PROGIT_SECRET_KEY=generate_a_secure_random_key_here
PROGIT_COOKIE_SECURE=false
PROGIT_SSH_ENABLED=true
PROGIT_SSH_PORT=2222

# OpenID Connect (OIDC) & OAuth2 Single Sign-On (SSO)
# Provider options: "google", "github", "microsoft", "keycloak", "generic"
PROGIT_OIDC_ENABLED=false
PROGIT_OIDC_PROVIDER=google
PROGIT_OIDC_DISPLAY_NAME="Google Workspace"
PROGIT_OIDC_CLIENT_ID=your_client_id_here
PROGIT_OIDC_CLIENT_SECRET=your_client_secret_here
# Optional: restrict sign-in to company email domain(s)
PROGIT_OIDC_ALLOWED_DOMAINS="company.com,omc.co.in"
# Optional for Keycloak / Okta / Dex (auto-discovers endpoints):
# PROGIT_OIDC_ISSUER_URL="https://auth.example.com/realms/master"
PROGIT_OIDC_AUTO_PROVISION=true

# Global repository and organization creation limits per user (-1 = unlimited, 0 = disabled, >0 = limit)
PROGIT_REPO_MAX_CREATION_LIMIT=-1
PROGIT_ORG_MAX_CREATION_LIMIT=-1
